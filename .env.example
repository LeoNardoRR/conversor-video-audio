# Use :80 para testar pelo IP. Troque por conversor.seudominio.com.br para HTTPS automático.
SITE_ADDRESS=:80

# A versão de arquivos grandes começa protegida contra uso não autorizado.
BASIC_AUTH_USER=komanda
BASIC_AUTH_HASH='$2a$14$SUBSTITUA_PELO_HASH_GERADO_PELO_CADDY'

# Ajuste conforme o espaço livre no disco da VPS.
MAX_UPLOAD_GB=12
MIN_FREE_GB=5
RETENTION_HOURS=6
MAX_CONCURRENT_JOBS=1

# Áudio para texto: duração máxima e modelo local Whisper na VPS.
MAX_TRANSCRIPTION_HOURS=6

# Lead Intel: limite por origem a cada 10 minutos.
RESEARCH_RATE_LIMIT=30

# Opcional: habilita pesquisa por nome empresarial e resultados da web.
# Crie a chave no painel oficial do Brave Search e nunca coloque a chave no frontend.
BRAVE_SEARCH_API_KEY=
